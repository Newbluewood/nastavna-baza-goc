# Canonical key names: backend/env.manifest.json (service=fe)
# Diff from backend/: npm run env:diff -- --service=fe
# [required on Netlify] Site API (local Express or Render baza-goc-api)
VITE_API_BASE_URL=http://127.0.0.1:3000
# [required on Netlify] Chat agent — must match Render chat-agent-psjk host
VITE_CHAT_API_URL=https://chat-agent-psjk.onrender.com
# [optional] UI flag
# VITE_AGENT_ENABLED=true
# [optional] PostHog browser capture
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Local-only helper (not a VITE_* Netlify var)
POSTHOG_PERSONAL_API_KEY=phx_...
