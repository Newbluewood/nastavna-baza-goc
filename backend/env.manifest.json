{
  "hosts": {
    "chatAgent": "https://chat-agent-psjk.onrender.com",
    "siteApi": "https://baza-goc-api.onrender.com",
    "frontend": "https://nastavnabazagoc.netlify.app",
    "ingestUrl": "https://chat-agent-psjk.onrender.com/api/ingest"
  },
  "pairs": [
    {
      "key": "INGEST_WEBHOOK_SECRET",
      "services": ["api", "agent"],
      "note": "Same secret on baza-goc-api and chat-agent"
    },
    {
      "key": "INGEST_WEBHOOK_URL",
      "services": ["api"],
      "mustEqualHost": "ingestUrl",
      "note": "Must point at chat-agent-psjk /api/ingest"
    },
    {
      "key": "VITE_CHAT_API_URL",
      "services": ["fe"],
      "mustEqualHost": "chatAgent",
      "note": "Netlify + local FE → same chat-agent host"
    }
  ],
  "services": {
    "api": {
      "label": "baza-goc-api",
      "localEnv": ".env",
      "required": [
        "JWT_SECRET",
        "GUEST_JWT_SECRET",
        "FRONTEND_URL",
        "ALLOWED_ORIGINS",
        "INGEST_WEBHOOK_URL",
        "INGEST_WEBHOOK_SECRET"
      ],
      "requiredOneOf": [
        ["DATABASE_URL", "DB_HOST"]
      ],
      "optional": [
        "DB_HOST",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_PORT",
        "DB_SSL",
        "DB_POOL_SIZE",
        "PORT",
        "EMAIL_USER",
        "EMAIL_APP_PASSWORD",
        "EMAIL_FROM",
        "EMAIL_REPLY_TO",
        "BREVO_API_KEY",
        "DEEPL_API_KEY",
        "AI_ENABLED",
        "AI_PROVIDER",
        "AI_API_KEY",
        "AI_MODEL",
        "AI_BUDGET_FAIL_OPEN",
        "API_RATE_LIMIT_ENABLED",
        "LOGIN_RATE_MAX",
        "INQUIRY_RATE_MAX",
        "LIKE_RATE_MAX",
        "CHAT_HISTORY_RATE_MAX",
        "JSON_BODY_LIMIT",
        "AVAILABILITY_PAST_DAYS",
        "AVAILABILITY_FUTURE_MONTHS",
        "USE_VECTOR_SEARCH",
        "QDRANT_URL",
        "QDRANT_API_KEY",
        "QDRANT_COLLECTION",
        "EMBEDDING_PROVIDER",
        "EMBEDDING_SERVICE_URL",
        "EMBEDDING_URL",
        "EMBEDDING_TIMEOUT_MS",
        "EMBEDDING_RETRY_COUNT",
        "GEMINI_API_KEY",
        "GEMINI_EMBEDDING_MODEL",
        "GEMINI_EMBEDDING_OUTPUT_DIM",
        "OPENAI_API_KEY",
        "HUGGINGFACE_API_KEY",
        "HUGGINGFACE_EMBEDDING_MODEL",
        "CA_CERT_PATH",
        "DB_URI",
        "POSTHOG_PERSONAL_API_KEY",
        "POSTHOG_PROJECT_ID",
        "POSTHOG_HOST",
        "WEATHER_LAT",
        "WEATHER_LON",
        "WEATHER_TIMEZONE",
        "GOC_DESTINATION_LABEL",
        "GOC_DESTINATION_LAT",
        "GOC_DESTINATION_LON",
        "ADMIN_SEED_USERNAME",
        "ADMIN_SEED_PASSWORD",
        "SMOKE_BASE_URL",
        "AGENT_DB_USER",
        "AGENT_DB_PASSWORD"
      ]
    },
    "agent": {
      "label": "chat-agent",
      "localEnv": "../../chat-agent/.env",
      "required": [
        "DB_HOST",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_PORT",
        "INGEST_WEBHOOK_SECRET",
        "QDRANT_URL",
        "QDRANT_API_KEY",
        "EMBEDDING_MODE",
        "ALLOWED_ORIGINS"
      ],
      "requiredOneOf": [
        ["ANTHROPIC_API_KEY", "GEMINI_API_KEY"]
      ],
      "optional": [
        "DB_SSL",
        "DB_POOL_SIZE",
        "PORT",
        "ANTHROPIC_API_KEY",
        "GEMINI_API_KEY",
        "GEMINI_EMBEDDING_MODEL",
        "AI_MODEL",
        "AI_FALLBACK_MODEL",
        "HUGGINGFACE_API_KEY",
        "HUGGINGFACE_EMBEDDING_MODEL",
        "CRON_SECRET",
        "INGEST_DEBOUNCE_MS",
        "RATE_LIMIT_MAX",
        "RATE_LIMIT_WINDOW_MS",
        "CHAT_RATE_MAX",
        "CHAT_RATE_WINDOW_MS",
        "CHAT_RATE_LIMIT_ENABLED",
        "CHAT_RATE_MAX_PER_WINDOW",
        "CHAT_SHORT_WINDOW_MS",
        "CHAT_RATE_RELIEF_MS",
        "CHAT_RATE_WARN_PERCENT",
        "AI_BUDGET_GATE_ENABLED",
        "AI_MONTHLY_BUDGET_EUR",
        "AI_USER_MONTHLY_BUDGET_EUR",
        "AI_BUDGET_FAIL_OPEN",
        "AI_MAX_TOKENS"
      ]
    },
    "fe": {
      "label": "netlify-fe",
      "localEnv": "../frontend/.env",
      "required": [
        "VITE_API_BASE_URL",
        "VITE_CHAT_API_URL"
      ],
      "optional": [
        "VITE_AGENT_ENABLED",
        "VITE_POSTHOG_KEY",
        "VITE_POSTHOG_HOST",
        "POSTHOG_PERSONAL_API_KEY"
      ]
    }
  }
}
